# LUNOR Business Manager — Server environment
# Copy to .env and adjust

# Port the API runs on
PORT=5000

# MongoDB connection string.
# Leave empty to use an embedded in-memory MongoDB (auto-starts a local temp mongod) for development.
# Example with MongoDB Atlas (database "lunor_account" holds all LUNOR app data):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/lunor_account
MONGODB_URI=

# JWT secret — change to a long random string in production.
# Leave JWT_EXPIRES_IN empty for non-expiring tokens (stay logged in until logout).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development

# Business timezone (Asia/Dhaka)
BUSINESS_TIMEZONE=Asia/Dhaka

# Rate limiting: max requests per 15 minutes
RATE_LIMIT_MAX=1000