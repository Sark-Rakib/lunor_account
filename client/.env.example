# LUNOR Business Manager — Client environment
# Copy to .env.local for local development (this file is git-tracked for reference only).
# Build-time public variables are inlined by Next.js, so set them on the deploy
# platform (Vercel project settings -> Environment Variables) BEFORE building.

# Full URL of the deployed Express API — no trailing slash.
# In production this is your server project's Vercel URL, e.g.
#   NEXT_PUBLIC_API_URL=https://lunor-api-<your-suffix>.vercel.app/api
NEXT_PUBLIC_API_URL=